{
  "name": "@ultirequiem/tixte",
  "version": "0.0.0-development",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "lib/**/*"
  ],
  "author": "Eliaz Bobadilla <eliaz.bobadilladev@gmail.com>",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "build:docs": "typedoc --out docs src",
    "dev:docs": "typedoc --watch --out docs src",
    "fmt": "prettier --write 'src/**/*.ts'",
    "lint": "eslint 'src/**/*.ts' && prettier --check 'src/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "eslint-plugin-unicorn": "^79.0.0",
    "prettier": "^3.9.10",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "api",
    "wrapper",
    "tixte"
  ],
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UltiRequiem/tixte-js.git"
  },
  "bugs": {
    "url": "https://github.com/UltiRequiem/tixte-js/issues"
  },
  "homepage": "https://ulti.js.org/tixte-js/",
  "description": "Typed, dependency-free client for the Tixte API"
}
